# =============================================================================
# Salin menjadi .env lalu isi. JANGAN commit file .env ke git.
# API key HANYA dari sini; tidak boleh masuk config.yaml atau kode.
# -----------------------------------------------------------------------------
# Syarat keamanan API key Binance:
#   - Aktifkan hanya izin "Enable Futures". JANGAN aktifkan "Enable Withdrawals".
#   - Aktifkan IP whitelist untuk IP server bot.
#   - Untuk mulai, pakai kunci dari https://testnet.binancefuture.com
# =============================================================================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Opsional: notifikasi Telegram
TELEGRAM_BOT_TOKEN=
